# ── VTechOTP Bot Configuration ───────────────────────────────────────────────

# Base URL API VTechOTP v1
# Untuk APK/Backend: https://app.otp.vtech.biz.id/api/v1
# Untuk Web Portal: https://vtechotp.web.id/api/v1
API_BASE_URL=https://app.otp.vtech.biz.id/api/v1

# Token API Developer Anda (Dapatkan dari Menu Developer di Dashboard VTechOTP)
API_TOKEN=vtk_your_api_token_here

# Secret Webhook untuk verifikasi signature (HMAC-SHA256)
WEBHOOK_SECRET=sec_your_webhook_secret_here

# Port Server Webhook Lokal
PORT=3000
